#include <iostream>
using namespace std;
int main()
{
    int a, b, r, opcion;
    
cout<<"ingrese a: ";
cin>> a;
cout<<"ingrese b: ";
cin>> b;
cout<<"1.- Suma"<<endl;
cout<<"2.- Resta"<<endl;
cout<<"3.- Multiplicacion"<<endl;
cout<<"4.- Division"<<endl;
cout<<"0.- Salir"<<endl;
cout<<"Elegir una opcion: ";
cin>>opcion;


switch(opcion){
    case 1:
       r=a+b;
       break;
    case 2:
       r=a-b;
       break;
    case 3:
       r=a*b;
       break;
    case 4:
       r=a/b;
       break;
    case 0:
       cout<<"salir";
    default:
       cout<<"Error";
}
cout<<"el resultado es: "<<r;
return 0;
}
