#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double a, b, c, D, x1, x2, x;
    cout << "Ingrese a: ";
    cin >> a;
    cout << "Ingrese b: ";
    cin >> b;
     cout << "Ingrese c: ";
    cin >> c;
    D = b*b - 4*a*c;

    if (D > 0) {
        x1 = (-b + sqrt(D)) / (2*a);
        x2 = (-b - sqrt(D)) / (2*a);
        cout << "Dos soluciones reales: x1 = " << x1 << ", x2 = " << x2 << endl;
    } else if (D == 0) {
        x = -b / (2*a);
        cout << "Una solucion doble: x = " << x << endl;
    } else {
         x = sqrt(-D) / (2*a); 
        cout << "Soluciones complejas: " << endl;
        cout << "x1 = -b/(2a) + " << x << "i" << endl;
        cout << "x2 = -b/(2a) - " << x << "i" << endl;
    }

    return 0;
}
