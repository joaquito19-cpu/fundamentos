#include <iostream>
#include <cmath>
using namespace std;
int main(){
    float x,y,z,s,area;
    cout << "Ingresa el lado x: ";
    cin >> x;
    cout << "Ingresa el lado y: ";
    cin >> y;
    cout << "Ingresa el lado z: ";
    cin >> z;
    s = (x + y + z) / 2;
    area= sqrt(s*(s-x)*(s-y)*(s-z));
    cout<< "El area es:"<<area;
    
    return 0;
}
