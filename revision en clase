#include <iostream>
using namespace std;
void concatenarVectores(int a[], int n, int b[], int m, int c[]);
int main() {
    int n, m;
    cout << "Ingrese el tamaño n del primer vector: ";
    cin >> n;
    cout << "Ingrese el tamaño m del segundo vector: ";
    cin >> m;
    if (n <= 0 || m <= 0) {
        cout << "Los tamaños deben ser positivos." << endl;
        return 0;
    }
    int A[n];
    int B[m];
    int C[n + m];
    cout << "Vector A: "<< endl;
    for (int i = 0; i < n; i++) {
        cout << "A[" << i << "]: ";
        cin >> A[i];
    }
    cout << "\n--- Vector B ---" << endl;
    for (int i = 0; i < m; i++) {
        cout << "B[" << i << "]: ";
        cin >> B[i];
    }
    concatenarVectores(A, n, B, m, C);
    cout << "\nVector A: [ ";
    for (int i = 0; i < n; i++) 
        cout << A[i] << " ";
    cout << "]" << endl;
    cout << "Vector B: [ ";
    for (int i = 0; i < m; i++) 
        cout << B[i] << " ";
    cout << "]" << endl;
    cout << "Vector Concatenado de tamaño " << n + m << ": [ ";
    for (int i = 0; i < n + m; i++) 
        cout << C[i] << " ";
    cout << "]" << endl;
    return 0;
}
void concatenarVectores(int a[], int n, int b[], int m, int c[]) {
    for (int i = 0; i < n; i++) 
        c[i] = a[i];
    for (int i = 0; i < m; i++) 
        c[n + i] = b[i];
}
