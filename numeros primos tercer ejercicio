#include <iostream>
#include <cmath>

using namespace std;

int main() {
    char repetir = 's'; 

    while (repetir == 's' || repetir == 'S') {
        bool flag;
        int n, cont = 2, cont2 = 0;
        
        cout << "Ingrese la cantidad de numeros primos que desea mostrar: ";
        cin >> n;
        
        while (cont2 < n) {
            flag = true;
            for (int i = 2; i <= sqrt(cont); i++) {
                if (cont % i == 0) {
                    flag = false;
                    break;
                }
            }
            
            if (flag) {
                cout << cont << ", ";
                cont2++;
            }
            cont++;
        }
        
    
        cout << "¿Desea realizar otra operacion? (s/n): ";
        cin >> repetir;
        cout << endl;

        switch (repetir) {
            case 's':
            case 'S':
                
                break;
            case 'n':
            case 'N':
                cout << "Saliendo del programa";
                break;
            default:
                cout << " Finalizando programa";
                repetir = 'n'; 
                break;
        }
    }

    return 0;
}
