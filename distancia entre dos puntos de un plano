#include <iostream>
#include <math.h>
using namespace std;

int main() {
    double x1, y1, x2, y2, distancia;

    cout << "Ingrese x1: ";
    cin >> x1;

    cout << "Ingrese y1: ";
    cin >> y1;

    cout << "Ingrese x2: ";
    cin >> x2;

    cout << "Ingrese y2: ";
    cin >> y2;

    distancia = sqrt(pow(x2 - x1, 2) + pow(y2 - y1, 2));

    cout << "La distancia entre los puntos es: " << distancia << endl;

    return 0;
}
